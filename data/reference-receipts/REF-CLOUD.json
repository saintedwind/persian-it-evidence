32\u0634 \u0645\u06cc\u200c\u067e\u0631\u062f\u0627\u0632\u062f\u060c \u0628\u0647 \u0647\u0645\u06cc\u0646 \u062a\u0631\u062a\u06cc\u0628 \u0645\u062f\u0627\u0631\u06a9 \u0648 \u0641\u0627\u06cc\u0644\u200c\u0647\u0627 \u0631\u0627 \u062f\u0631 \u0647\u0627\u0631\u062f \u062f\u06cc\u0633\u06a9 \u06cc\u0627 \u0635\u0641\u062d\u0647 \u0633\u062e\u062a \u062e\u0648\u062f \u0630\u062e\u06cc\u0631\u0647 \u0645\u06cc\u200c\u06a9\u0646\u062f\u060c \u0627\u0645\u06a9\u0627\u0646 \u0627\u06cc\u062c\u0627\u062f \u0627\u0631\u062a\u0628\u0627\u0637 \u0645\u06cc\u0627\u0646 \u0627\u0641\u0631\u0627\u062f \u0631\u0627 \u0641\u0631\u0627\u0647\u0645 \u0645\u06cc\u200c\u0622\u0648\u0631\u062f \u06a9\u0647 \u0627\u06cc\u0646 \u0627\u0645\u0648\u0631 \u0686\u06cc\u0632\u06cc \u0628\u06cc\u0634 \u0627\u0632 \u06cc\u06a9 \u0645\u062d\u0627\u0633\u0628\u0647 \u0648 \u067e\u0631\u062f\u0627\u0632\u0634 \u0635\u0631\u0641 \u0627\u0633\u062a. \u0628\u0647 \u0639\u0644\u0627\u0648\u0647 \u062f\u0631 \u0645\u0639\u0646\u0627\u06cc \u0639\u0644\u0648\u0645 \u0631\u0627\u06cc\u0627\u0646\u0647 \u0645\u0639\u0627\u062f\u0644\u200c\u0647\u0627\u06cc \u062f\u06cc\u06af\u0631\u06cc \u0628\u0631\u0627\u06cc \u06a9\u0644\u0645\u0627\u062a \u00ab\u0645\u062d\u0627\u0633\u0628\u0647\u00bb \u0648 \u00ab\u067e\u0631\u062f\u0627\u0632\u0634\u00bb \u0648\u062c\u0648\u062f \u062f\u0627\u0631\u0646\u062f\u060c \u0645\u0627\u0646\u0646\u062f\u201d calculation\u201d \u0648\u201d processing \u201d\u060c \u06a9\u0647 \u0639\u062f\u0645 \u062a\u0645\u0627\u06cc\u0632 \u0627\u06cc\u0646 \u06a9\u0644\u0645\u0627\u062a \u0628\u0627 \u06cc\u06a9\u062f\u06cc\u06af\u0631 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u062f \u0645\u0646\u0634\u0623 \u0627\u0634\u062a\u0628\u0627\u0647 \u062f\u0631 \u062f\u0631\u06a9 \u0627\u06cc\u0646 \u0645\u0641\u0627\u0647\u06cc\u0645 \u0634\u0648\u062f.\n\u0631\u0627\u06cc\u0627\u0646\u0634 \u0627\u0628\u0631\u06cc \u0631\u0627\u0647\u06a9\u0627\u0631\u0647\u0627\u06cc\u06cc \u0628\u