27\u06cc\u0627\u0646\u0634\u06cc \u0645\u0648\u0631\u062f \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u062e\u0648\u062f (\u0627\u06af\u0631 \u0647\u0632\u06cc\u0646\u0647 \u0627\u0632 \u06a9\u0627\u0631\u0628\u0631 \u062f\u0631\u06cc\u0627\u0641\u062a \u0634\u0648\u062f) \u0631\u0627 \u067e\u0631\u062f\u0627\u062e\u062a \u062e\u0648\u0627\u0647\u062f \u06a9\u0631\u062f \u06a9\u0647 \u062f\u0631 \u0627\u0635\u0637\u0644\u0627\u062d \u0628\u0647 \u0627\u06cc\u0646 \u0645\u062f\u0644 \u0645\u062d\u0627\u0633\u0628\u0647 \u0647\u0632\u06cc\u0646\u0647\u060c pay as you go \u06af\u0641\u062a\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f.\n\u0631\u0627\u06cc\u0627\u0646\u0634 \u0647\u0648\u0627\u06cc\u06cc \u0631\u0627 \u06af\u0631\u0648\u0647\u06cc \u062a\u063a\u06cc\u06cc\u0631 \u0627\u0644\u06af\u0648\u0648\u0627\u0631\u0647\u200c\u0627\u06cc \u0645\u06cc\u200c\u062f\u0627\u0646\u0646\u062f \u06a9\u0647 \u062f\u0646\u0628\u0627\u0644\u0647\u200c\u0631\u0648\u06cc \u062a\u063a\u06cc\u06cc\u0631\u06cc \u0627\u0633\u062a \u06a9\u0647 \u062f\u0631 \u0627\u0648\u0627\u06cc\u0644 \u062f\u0647\u0647 \u06f1\u06f9\u06f8\u06f0 \u0627\u0632 \u0645\u062f\u0644 \u0631\u0627\u06cc\u0627\u0646\u0647 \u0628\u0632\u0631\u06af \u0628\u0647 \u0645\u062f\u0644 \u06a9\u0627\u0631\u062e\u0648\u0627\u0647-\u06a9\u0627\u0631\u0633\u0627\u0632 \u0635\u0648\u0631\u062a \u06af\u0631\u0641\u062a.\n\u06a9\u0627\u0631\u0628\u0631\u062f\u0647\u0627: \u0631\u0627\u06cc\u0627\u0646\u0634 \u0627\u0628\u0631\u06cc \u062f\u0631 \u0632\u0645\u06cc\u0646\u0647\u200c\u0647\u0627\u06cc \u0645\u062e\u062a\u0644\u0641\u06cc \u0645\u0627\u0646\u0646\u062f \u0645\u0631\u0627\u0642\u0628\u062a\u200c\u0647\u0627\u06cc \u0628\u0647\u062f\u0627\u0634\u062a\u06cc\u060c \u06a9\u0633\u0628 \u0648 \u06a9\u0627\u0631\u060c \u0633\u06cc\u0633\u062a\u0645 \u0647\u0648\u0634\u0645\u0646\u062f\u060c \u0633\u06cc\u0633\u062a\u0645 \u062a\u0644\u0641\u0646 \u0647\u0645\u0631\u0627\u0647 \u0648 \u0645\u062d\u0627\u0633\u0628\u0627\